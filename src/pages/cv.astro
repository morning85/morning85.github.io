---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import HorizontalShopItem from "@components/HorizontalShopItem.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug";
import dayjs from "dayjs";
import localizedFormat from "dayjs/plugin/localizedFormat";

dayjs.extend(localizedFormat);

const isMe = (auther: string) =>
  auther.startsWith("Asa Tomita") || auther.startsWith("富田 朝");

const latestPublications = (await getCollection("publications"))
  .filter(
    (post) => isMe(post.data.auther) && post.data.tags?.includes("Peer-Reviewed"),
  )
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const selectedTalks = (await getCollection("talks"))
  .filter((talk) => talk.data.tags?.includes("International"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Resume" sideBarActiveItemID="cv">
  <div class="pb-12 mt-5">
    <div class="text-5xl font-bold">Asa Tomita</div>
    <div class="py-2 mb-10">
      <p class="text-lg">
        2nd year Ph.D. student at Graduate School of Humanities and Sciences,
        Ochanomizu University Bekki Laboratory.
      </p>
    </div>

    <!-- Education -->
    <div class="text-3xl w-full font-bold mb-5">Education</div>
    <div class="time-line-container grid gap-4 mb-10">
      <TimeLineElement
        title="Ph.D. Student, Department of Advanced Sciences, Graduate School of Humanities and Sciences, Ochanomizu University, Japan"
        subtitle="April 2025 – Present"
      >
        Supervisor: Prof. Daisuke Bekki
      </TimeLineElement>
      <TimeLineElement
        title="Master's Degree, Department of Advanced Sciences, Graduate School of Humanities and Sciences, Ochanomizu University, Japan"
        subtitle="April 2023 – March 2025"
      >
        Supervisor: Prof. Daisuke Bekki
      </TimeLineElement>
      <TimeLineElement
        title="Bachelor's Degree, Department of Information Science, School of Science, Ochanomizu University, Japan"
        subtitle="April 2019 – March 2023"
      >
        Supervisor: Prof. Daisuke Bekki
      </TimeLineElement>
    </div>

    <!-- Research Experience -->
    <div class="text-3xl w-full font-bold mb-5">Research Experience</div>
    <div class="time-line-container mb-10">
      <TimeLineElement
        title="Guest Ph.D. Candidate, Utrecht University, Netherlands"
        subtitle="March 2026 – June 2026"
      >
        Faculty of Humanities, Department of Language, Literature and
        Communication,<br />
        Institute for Language Sciences (ILS)
      </TimeLineElement>
    </div>

    <!-- Publications -->
    <div class="text-3xl w-full font-bold mb-5">Latest Publications</div>
    {
      latestPublications.map((post) => (
        <>
          <HorizontalCard
            title={post.data.title}
            auther={post.data.auther}
            desc={post.data.description}
            pubDate={dayjs(post.data.pubDate).format("ll")}
            url={"/publications/" + createSlug(post.data.title, post.slug)}
            paperUrl={post.data.paperUrl}
            slideUrl={post.data.slideUrl}
            tags={post.data.tags}
            target="_self"
            badge={post.data.badge}
          />
          <div class="divider my-0" />
        </>
      ))
    }
    <div class="flex justify-end mt-3 mb-10">
      <a href="/publications" class="link font-semibold">More publications →</a>
    </div>

    <!-- Talks -->
    <div class="text-3xl w-full font-bold mb-5">Selected Talks</div>
    {
      selectedTalks.map((talk) => (
        <>
          <HorizontalCard
            title={talk.data.title}
            auther={talk.data.auther}
            desc={talk.data.description}
            pubDate={dayjs(talk.data.pubDate).format("ll")}
            url={"/talks/" + createSlug(talk.data.title, talk.slug)}
            paperUrl={talk.data.paperUrl}
            slideUrl={talk.data.slideUrl}
            tags={talk.data.tags}
            target="_self"
            badge={talk.data.badge}
          />
          <div class="divider my-0" />
        </>
      ))
    }
    <div class="flex justify-end mt-3 mb-10">
      <a href="/talks" class="link font-semibold">More talks →</a>
    </div>

    <!-- Grants -->
    <div class="text-3xl w-full font-bold mb-5">Grants</div>
    <HorizontalShopItem
      title="JST BOOST（次世代AI人材育成プロジェクト）"
      desc="異種専門知識の融合と価値観の多様性に基づく次世代AI開発人材の育成"
      pricing="2025 – Present"
      url="https://www.jst.go.jp/jisedai/boost-s/"
      hoverable={false}
    />
    <div class="divider my-0"></div>
    <HorizontalShopItem
      title="JST SPRING（次世代研究者挑戦的研究プログラム）"
      desc="「革新」×「共創」で未来を拓く女性博士育成プロジェクト T-COCOA"
      pricing="2025"
      url="https://www.jst.go.jp/jisedai/spring/"
      badge="SELECTED (DECLINED)"
      badgeClass="bg-gray-500 border-gray-500 text-white"
      bgClass="bg-base-100 opacity-60"
      hoverable={false}
    />
    <div class="divider my-0 mb-10"></div>

    <!-- Teaching -->
    <div class="text-3xl w-full font-bold mb-5">Teaching Experience</div>
    <div class="time-line-container mb-10">
      <TimeLineElement
        title="Teaching Assistant of General Topology"
        subtitle="September 2026 – February 2027"
      >
        Ochanomizu University
      </TimeLineElement>
      <TimeLineElement
        title="School Teaching Assistant of Informatics"
        subtitle="April 2023 – Present"
      >
        Ochanomizu University Senior High School
      </TimeLineElement>
      <TimeLineElement
        title="Teaching Assistant of General Topology"
        subtitle="September 2023 – February 2024"
      >
        Ochanomizu University
      </TimeLineElement>
    </div>

    <!-- Academic Service -->
    <div class="text-3xl w-full font-bold mb-5">Academic Service</div>
    <div class="time-line-container mb-10">
      <TimeLineElement title="Local Organizer, LENLS22" subtitle="November 2026">
        <a
          href="https://lenls.github.io/lenls22/"
          class="link"
          target="_blank"
          rel="noopener noreferrer"
        >
          Logic and Engineering of Natural Language Semantics 22 (LENLS22)
        </a>
        <br />
        Kobe University, Japan
      </TimeLineElement>
    </div>

    <!-- Internships -->
    <div class="text-3xl w-full font-bold mb-5">Internships</div>
    <div class="time-line-container mb-10">
      <TimeLineElement
        title="Recruit Co., Ltd."
        subtitle="August 2026 – September 2026"
      >
        <a
          href="https://www.recruit.co.jp/employment/students/internship/dsintern/"
          class="link"
          target="_blank"
          rel="noopener noreferrer"
        >
          RECRUIT INTERNSHIP for Data Specialists 2026
        </a>
      </TimeLineElement>
      <TimeLineElement title="Jool Corp." subtitle="December 2023 – Present">
        Software Engineer
      </TimeLineElement>
      <TimeLineElement
        title="Fujitsu, Ltd."
        subtitle="August 2023 – September 2023"
      >
        Research and Development
      </TimeLineElement>
      <TimeLineElement title="HIHITI, Inc." subtitle="May 2021 – November 2021">
        Frontend Engineer
      </TimeLineElement>
    </div>

    <!-- Other -->
    <div class="text-3xl w-full font-bold mb-5">Other Activities</div>
    <div class="time-line-container mb-10">
      <TimeLineElement title="Open Hack U 2022" subtitle="August 2022">
        Online Hackathon
      </TimeLineElement>
    </div>

    <!-- Skills -->
    <div class="text-3xl w-full font-bold mb-5">Skills</div>
    <ul class="list-disc md:columns-3 mx-6">
      <li>Haskell</li>
      <li>Python</li>
      <li>JavaScript</li>
      <li>Natural Language Processing</li>
    </ul>
  </div>
</BaseLayout>
